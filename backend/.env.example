# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Orígenes permitidos por CORS, separados por comas. Vacío = permitir todos (solo dev).
CORS_ORIGINS=http://localhost:3001

# PostgreSQL + PostGIS Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=supermarket_pricing_db
# En runtime debe quedar en false. El esquema se crea con `npm run seed` (dev) o migraciones (prod).
DB_SYNCHRONIZE=false
DB_LOGGING=true
# Opcion alternativa (todos los proveedores en la nube): postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Fuente oficial de precios: SEPA / "Precios Claros" (Secretaría de Comercio).
# Los endpoints de lectura son públicos: no requiere API key.
SEPA_BASE_URL=https://d3e6htiiul5ek9.cloudfront.net/prod
SEPA_TIMEOUT_MS=20000
SEPA_USER_AGENT=PreciosSmart/1.0 (+https://localhost) prices-intelligence-demo

# Ingesta automática diaria de SEPA (opcional).
# SEPA_AUTO_INGEST=true  ->  corre todos los días a SEPA_INGEST_HOUR
SEPA_AUTO_INGEST=false
SEPA_INGEST_LAT=-34.8207
SEPA_INGEST_LNG=-57.9675
SEPA_INGEST_RADIUS=10
SEPA_INGEST_HOUR=6
SEPA_INGEST_MAX_BRANCHES=5
SEPA_INGEST_MAX_PRODUCTS=300

# OCR de tickets con Azure AI Document Intelligence (opcional).
# Si faltan endpoint/key, el backend usa el extractor por defecto (el cliente
# envia los items ya extraidos).
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30-preview
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_MS=45000
