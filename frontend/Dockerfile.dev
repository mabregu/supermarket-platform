# Imagen de desarrollo para el frontend Next.js (next dev en el puerto 3001).
FROM node:20-alpine

WORKDIR /app

# Instalar dependencias primero para aprovechar la caché de capas.
COPY package*.json ./
RUN npm install

# El código se monta como volumen en docker-compose.dev.yml (para el hot reload).
COPY . .

EXPOSE 3001

CMD ["npm", "run", "dev"]
